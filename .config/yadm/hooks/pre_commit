#!/usr/bin/env python3
"""Block yadm commits that introduce internal infrastructure detail.

This dotfiles repo has a public remote. Tools that write into tracked config
(Claude Code settings, shell history captures, generated profiles) can pull in
private hostnames and addresses without being asked. This hook scans the lines
a commit would ADD and refuses the commit when one matches.

Patterns come from two places:

  built-in   RFC1918 addresses and similar generic markers. Safe to publish,
             so they live in this file.
  local      Org-specific terms - internal domains, hostnames, database
             identifiers. These are themselves sensitive, so they live in
             leak-patterns.txt next to this hook and are excluded from the
             repo. One pattern per line, '#' starts a comment. Blank when
             absent, in which case only the built-ins apply.

Escape hatch for a false positive:

    YADM_SKIP_LEAK_CHECK=1 yadm commit ...
"""

import os
import re
import subprocess
import sys

HOOK_DIR = os.path.dirname(os.path.abspath(__file__))
PATTERNS_FILE = os.path.join(HOOK_DIR, "leak-patterns.txt")

BUILTIN = [
    (r"\b10\.\d{1,3}\.\d{1,3}\.\d{1,3}\b", "private IPv4 address (10/8)"),
    (r"\b192\.168\.\d{1,3}\.\d{1,3}\b", "private IPv4 address (192.168/16)"),
    (
        r"\b172\.(?:1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}\b",
        "private IPv4 address (172.16/12)",
    ),
]


def load_local_patterns():
    if not os.path.isfile(PATTERNS_FILE):
        return []
    out = []
    with open(PATTERNS_FILE, encoding="utf-8") as f:
        for raw in f:
            line = raw.split("#", 1)[0].strip()
            if line:
                out.append((line, "internal identifier"))
    return out


def git(args):
    repo = os.environ.get("YADM_HOOK_REPO")
    work = os.environ.get("YADM_HOOK_WORK")
    if not repo or not work:
        sys.exit("pre_commit: YADM_HOOK_REPO/YADM_HOOK_WORK unset; refusing to guess")
    cmd = ["git", "--git-dir", repo, "--work-tree", work] + args
    return subprocess.run(cmd, capture_output=True, text=True).stdout


def commits_all(full_command):
    """True when the command stages tracked changes itself, i.e. -a/--all.

    Matching on a bare 'a' would also catch --amend, which stages nothing, so
    only short-flag clusters and the exact long form count.
    """
    for token in full_command.split():
        if token == "--all":
            return True
        if len(token) > 1 and token[0] == "-" and token[1] != "-" and "a" in token[1:]:
            return True
    return False


def added_lines():
    """Yield (path, lineno, text) for every line this commit would add.

    'yadm commit -a' stages tracked changes after the pre hook runs, so the
    index alone would miss them. Scan the unstaged tracked diff too in that
    case.
    """
    diffs = [git(["diff", "--cached", "-U0"])]
    if commits_all(os.environ.get("YADM_HOOK_FULL_COMMAND", "")):
        diffs.append(git(["diff", "-U0"]))

    for diff in diffs:
        path, lineno = None, 0
        for line in diff.splitlines():
            if line.startswith("+++ b/"):
                path = line[6:]
            elif line.startswith("@@"):
                m = re.search(r"\+(\d+)", line)
                lineno = int(m.group(1)) if m else 0
            elif line.startswith("+") and not line.startswith("+++"):
                yield path, lineno, line[1:]
                lineno += 1


def main():
    if os.environ.get("YADM_SKIP_LEAK_CHECK"):
        return 0

    patterns = [(re.compile(p, re.IGNORECASE), why) for p, why in BUILTIN + load_local_patterns()]

    hits = []
    for path, lineno, text in added_lines():
        for rx, why in patterns:
            m = rx.search(text)
            if m:
                hits.append((path, lineno, why, m.group(0)))
                break

    if not hits:
        return 0

    print("yadm pre_commit: refusing to commit internal detail to a public repo\n")
    for path, lineno, why, match in hits:
        print(f"  {path}:{lineno}  {why}: {match}")
    print(f"\n{len(hits)} line(s) flagged.")
    print("Remove them, or bypass with: YADM_SKIP_LEAK_CHECK=1 yadm commit ...")
    return 1


if __name__ == "__main__":
    sys.exit(main())
