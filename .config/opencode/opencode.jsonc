{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/deepseek/deepseek-v4.1-flash",
  "small_model": "openrouter/google/gemini-3.1-flash-lite",
  "share": "manual",
  "autoupdate": "notify",
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "options": {
            "provider": {
              "order": ["wafer", "deepinfra", "parasail", "venice"],
              "allow_fallbacks": true
            }
          }
        }
      }
    }
  }
}