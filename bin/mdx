#!/usr/bin/env bash
#
# mdx - render a markdown file to html, pdf, or docx.
#
# HTML and PDF are produced from the same stylesheet, so they look alike.
# Word takes its styling from a reference document instead, because .docx
# uses named styles rather than CSS.

set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/mdx"
css="${MDX_CSS:-$config_dir/style.css}"
reference_doc="${MDX_REFERENCE_DOC:-$config_dir/reference.docx}"

format=html
outfile=
open_after=false

usage() {
  cat <<EOF
usage: mdx [-t html|pdf|docx] [-o OUTFILE] [-O] FILE.md

  -t FORMAT   output format: html, pdf, or docx (default: html)
  -o OUTFILE  output path (default: input name with the format's extension)
  -O          open the result when it finishes
  -h          show this help

HTML output is self-contained - styles and images are inlined into the one
file, so it can be emailed and will open anywhere.

Styling: $css
Word template (optional): $reference_doc

Override either with \$MDX_CSS or \$MDX_REFERENCE_DOC.
EOF
}

die() {
  printf 'mdx: %s\n' "$*" >&2
  exit 1
}

while getopts ':t:o:Oh' opt; do
  case "$opt" in
    t) format=$OPTARG ;;
    o) outfile=$OPTARG ;;
    O) open_after=true ;;
    h)
      usage
      exit 0
      ;;
    :) die "option -$OPTARG requires an argument" ;;
    \?) die "unknown option -$OPTARG (try: mdx -h)" ;;
  esac
done
shift $((OPTIND - 1))

if [ $# -ne 1 ]; then
  usage >&2
  exit 2
fi

input=$1
[ -f "$input" ] || die "no such file: $input"
command -v pandoc >/dev/null 2>&1 || die "pandoc is not installed"

case "$format" in
  html | pdf | docx) ;;
  *) die "unsupported format: $format (want html, pdf, or docx)" ;;
esac

[ -n "$outfile" ] || outfile="${input%.*}.$format"

# Sets the <title> element without emitting a visible heading. Using `title`
# metadata instead would print the name into the top of the document, which
# duplicates the H1 most files already start with.
pagetitle=$(basename "${input%.*}")

# yaml_metadata_block keeps Obsidian frontmatter from rendering as a rule
# followed by stray key/value lines.
common=(
  --standalone
  --from gfm+yaml_metadata_block+footnotes
  --variable "pagetitle=$pagetitle"
)

case "$format" in
  html | pdf)
    [ -f "$css" ] || die "stylesheet not found: $css"
    ;;
esac

case "$format" in
  html)
    pandoc "${common[@]}" --embed-resources --css "$css" \
      --output "$outfile" -- "$input"
    ;;
  pdf)
    command -v weasyprint >/dev/null 2>&1 ||
      die "weasyprint is not installed (brew install weasyprint)"
    # --embed-resources inlines the CSS so weasyprint never has to resolve
    # the stylesheet path out of pandoc's temporary directory. --quiet drops
    # weasyprint's notes about CSS it does not implement, which pandoc's own
    # default styles trigger on every run.
    pandoc "${common[@]}" --embed-resources --css "$css" \
      --pdf-engine weasyprint --pdf-engine-opt=--quiet \
      --output "$outfile" -- "$input"
    ;;
  docx)
    docx_args=()
    if [ -f "$reference_doc" ]; then
      docx_args=(--reference-doc "$reference_doc")
    fi
    pandoc "${common[@]}" "${docx_args[@]}" --output "$outfile" -- "$input"
    ;;
esac

printf '%s\n' "$outfile"

if [ "$open_after" = true ]; then
  open "$outfile"
fi
